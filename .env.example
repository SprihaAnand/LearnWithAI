# LearnWithAI runtime configuration
#
# Copy these names into your deployment environment. This file intentionally
# contains no credentials. The Python server reads process environment variables
# directly; it does not load a .env file on its own.

# SQLite database location (default: data/learnwithai.db)
LEARNWITHAI_DB=data/learnwithai.db

# Static web application directory (default: web)
LEARNWITHAI_WEB_ROOT=web

# HTTP listener (defaults: 127.0.0.1:8000)
LEARNWITHAI_HOST=127.0.0.1
LEARNWITHAI_PORT=8000

# Authenticated token lifetime, in seconds. Choose a value appropriate to the
# deployment's session policy.
LEARNWITHAI_TOKEN_TTL_SECONDS=28800

# Maximum multipart video request size in bytes (default and hard cap:
# 104857600 / 100 MiB). The single-process server admits one upload at a time;
# use managed object storage for larger production media.
LEARNWITHAI_MAX_UPLOAD_BYTES=104857600

# Set to 1 behind HTTPS so short-lived private-video playback cookies include
# the Secure flag. Keep 0 only for local HTTP development.
LEARNWITHAI_COOKIE_SECURE=0

# Gemini keys are supplied by signed-in users for their active session only.
# Do not put a Gemini API key in this file or any deployment config used by
# this application.
